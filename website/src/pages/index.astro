---
import "../styles/site.css";

const title = "Tobby";
const tagline = "Go fetch your OCI assets — across every zone, all the way to air-gap.";
const description =
  "Tobby fetches OCI assets — container images, Helm charts, AI models, files — across isolated network zones, all the way to air-gapped environments. Recipe-driven, with a portable registry.";
const org = "https://github.com/tobby-fetch";
const repo = `${org}/tobby-fetch`;
const specRepo = `${org}/recipe-spec`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const carries = ["Container images", "Helm charts", "AI models", "Files"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={tagline} />
    <meta property="og:type" content="website" />
    <title>{title} — {tagline}</title>
    <style>
      /* hero (identity preserved from the teaser page) */
      .hero {
        position: relative;
        text-align: center;
        padding: 5.5rem 1.5rem 4rem;
        overflow: hidden;
      }
      .hero::before {
        content: "";
        position: absolute;
        inset: -20vmax;
        background: radial-gradient(
          42vmax 42vmax at 50% 34%,
          rgb(var(--bg-glow) / 0.14),
          transparent 60%
        );
        pointer-events: none;
      }
      .hero > * { position: relative; }
      .hero-inner { max-width: 40rem; margin: 0 auto; animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both; }

      .mark { width: 4.25rem; height: 4.25rem; margin: 0 auto 1.5rem; display: block; color: var(--accent); }
      .mark .trajectory { stroke-dasharray: 3 3.5; animation: dash 1.6s linear infinite; }

      h1 { font-size: clamp(2.4rem, 8vw, 3.6rem); line-height: 1; letter-spacing: -0.03em; margin: 0 0 0.85rem; font-weight: 700; }
      h1 .dot { color: var(--accent); }

      .tagline { font-size: clamp(1.05rem, 3.4vw, 1.35rem); line-height: 1.45; margin: 0 auto; max-width: 30rem; font-weight: 500; }
      .lede { font-size: clamp(0.92rem, 2.6vw, 1rem); line-height: 1.6; margin: 1rem auto 0; max-width: 34rem; color: var(--muted); }

      .carries { list-style: none; padding: 0; margin: 1.75rem auto 0; display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
      .carries li {
        font-size: 0.8rem; letter-spacing: 0.01em; padding: 0.35rem 0.75rem;
        border: 1px solid var(--hair); border-radius: 999px; background: var(--chip); white-space: nowrap;
      }

      .badge {
        margin-top: 2rem; display: inline-flex; align-items: center; gap: 0.5rem;
        font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
      }
      .badge .pulse {
        width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--accent);
        box-shadow: 0 0 0 0 rgb(var(--bg-glow) / 0.5); animation: pulse 2.2s ease-out infinite;
      }

      /* modes */
      .modes { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1rem; }
      .mode {
        background: var(--bg-raise); border: 1px solid var(--hair); border-radius: 0.8rem; padding: 1.3rem 1.4rem;
      }
      .mode h3 { margin: 0 0 0.5rem; font-size: 1.1rem; }
      .mode h3 span { color: var(--accent); margin-right: 0.4rem; }
      .mode p { margin: 0; font-size: 0.9rem; color: var(--muted); }

      @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
      @keyframes dash { to { stroke-dashoffset: -13; } }
      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgb(var(--bg-glow) / 0.5); }
        70% { box-shadow: 0 0 0 0.5rem rgb(var(--bg-glow) / 0); }
        100% { box-shadow: 0 0 0 0 rgb(var(--bg-glow) / 0); }
      }
      @media (prefers-reduced-motion: reduce) {
        .hero-inner { animation: none; }
        .mark .trajectory { animation: none; }
        .badge .pulse { animation: none; }
      }
    </style>
  </head>
  <body>
    <nav class="top">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>Tobby<span class="dot">.</span></a>
        <a href="#how">How it works</a>
        <a href={`${base}/quality/`}>Quality</a>
        <a href={`${base}/roadmap.html`}>Roadmap</a>
        <a href={`${repo}/tree/main/docs`} rel="noopener">Docs</a>
        <a href={repo} rel="noopener">GitHub</a>
      </div>
    </nav>

    <header class="hero">
      <div class="hero-inner">
        <svg class="mark" viewBox="0 0 48 48" fill="none" role="img" aria-label="Tobby logo">
          <path d="M7 15v-3a2 2 0 0 1 2-2h3M7 33v3a2 2 0 0 0 2 2h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.4" />
          <path d="M41 15v-3a2 2 0 0 0-2-2h-3M41 33v3a2 2 0 0 1-2 2h-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.4" />
          <path class="trajectory" d="M11 30C15 19 33 19 37 30" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.7" />
          <g stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
            <path d="M24 15.5l7 4v8l-7 4-7-4v-8l7-4z" fill="currentColor" fill-opacity="0.12" />
            <path d="M24 15.5l7 4-7 4-7-4 7-4z" fill="currentColor" fill-opacity="0.22" />
            <path d="M24 23.5v8" opacity="0.85" />
          </g>
        </svg>

        <h1>Tobby<span class="dot">.</span></h1>
        <p class="tagline">{tagline}</p>
        <p class="lede">
          Transfer OCI assets between network zones — from connected, through
          restricted, down to fully air-gapped — driven by declarative
          <strong>Recipes</strong>, with a portable registry built in.
        </p>

        <ul class="carries">
          {carries.map((item) => <li>{item}</li>)}
        </ul>

        <div class="btnrow" style="justify-content: center;">
          <a class="btn solid" href={`${repo}/blob/main/docs/SRS.md`} rel="noopener">Read the spec</a>
          <a class="btn" href={`${base}/quality/`}>Quality model</a>
        </div>

        <div><span class="badge"><span class="pulse"></span>Under active development — design first, code by milestone</span></div>
      </div>
    </header>

    <section class="band" id="how">
      <div class="wrap">
        <div class="kicker">Two modes, one binary</div>
        <h2>How it works</h2>
        <p class="intro">
          A <strong>Recipe</strong> describes an application as a pinned list of
          OCI artifacts; a <strong>Retriever</strong> lists what one zone wants.
          Tobby does the rest — in whichever mode the zone requires.
        </p>
        <div class="modes">
          <div class="mode">
            <h3><span>⇄</span>Passthrough</h3>
            <p>
              A long-lived service between two connected zones. It periodically
              re-resolves the zone's Retriever, verifies signatures and policy,
              and pushes <em>only what is missing</em> to the zone registry —
              recipes included, so every zone stays self-describing.
            </p>
          </div>
          <div class="mode">
            <h3><span>⛁</span>Mirror &amp; air-gap</h3>
            <p>
              A single binary on a workstation synchronizes recipes onto a
              self-contained transportable store. The medium crosses the air
              gap physically; on the far side, the same application re-verifies
              everything — media contents are untrusted until proven — and
              pushes to the zone registry.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="kicker">Security by construction</div>
        <h2>Nothing crosses unverified</h2>
        <div class="cards">
          <div class="card"><span class="glyph">✒</span><h3>Signed &amp; pinned</h3>
            <p>Cooked recipes are digest-pinned and cosign-signed (key-based — verification needs zero network). One signature attests the exact bytes of the whole delivery, re-checked before every push.</p></div>
          <div class="card"><span class="glyph">⌖</span><h3>Deterministic relocation</h3>
            <p>Every ingredient lands under its canonical source host — <code>docker.io/bitnami/wordpress</code> stays recognizable in any zone, across any number of hops. Mirror snippets are generated for the clusters.</p></div>
          <div class="card"><span class="glyph">☂</span><h3>Scanned offline</h3>
            <p>Trivy scanning with a configurable block/warn policy — and the vulnerability database travels as an OCI artifact through Tobby itself, so air-gapped scanning never goes stale by design.</p></div>
          <div class="card"><span class="glyph">▤</span><h3>Allow-listed</h3>
            <p>Sources and destinations are checked against an explicit registry allow-list before any transfer; a recipe cannot grant itself access that zone policy does not allow.</p></div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="kicker">Held to its own standard</div>
        <h2>A gate must be exemplary</h2>
        <p class="intro">
          Tobby gates what enters hardened zones — so its own releases are
          built to survive the same reviewers.
        </p>
        <ul class="checks">
          <li><strong>SLSA Build L3</strong> provenance from an isolated trusted builder, verifiable with <code>slsa-verifier</code></li>
          <li><strong>Reproducible builds</strong> — rebuild the tag, get bit-identical binaries, even fully offline</li>
          <li><strong>Zero-known-CVE images</strong> — declarative melange + apko assembly on Wolfi, rebuilt weekly</li>
          <li><strong>Signed CycloneDX SBOMs</strong> for every binary and image; <strong>OpenVEX</strong> statements for anything flagged that does not apply</li>
          <li><strong>No Node toolchain anywhere</strong> — the web UI is server-rendered Go + a single vendored htmx file</li>
        </ul>
        <div class="btnrow">
          <a class="btn" href={`${base}/quality/`}>The full quality model →</a>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="kicker">Design in the open</div>
        <h2>Read it before it's built</h2>
        <p class="intro">
          The complete design is public before the first line of product code.
          Review it, file issues, disagree with an ADR.
        </p>
        <div class="cards">
          <div class="card"><h3>Requirements (SRS)</h3>
            <p>Every functional and non-functional requirement, numbered, testable, with acceptance criteria. <a href={`${repo}/blob/main/docs/SRS.md`} rel="noopener">docs/SRS.md</a></p></div>
          <div class="card"><h3>14 decision records</h3>
            <p>Context, decision, consequences, alternatives — from the recipe format to the crucible test infrastructure. <a href={`${repo}/tree/main/docs/adr`} rel="noopener">docs/adr/</a></p></div>
          <div class="card"><h3>Recipe specification</h3>
            <p>The format, strict JSON Schemas, examples, Go SDK — Apache-2.0, separate repository, usable by any tool. <a href={specRepo} rel="noopener">recipe-spec</a></p></div>
          <div class="card"><h3>Roadmap</h3>
            <p>Milestones and features in three readings — technical, plain-language, business value (French). <a href={`${base}/roadmap.html`}>View the roadmap</a></p></div>
        </div>
      </div>
    </section>

    <footer class="site">
      <div class="wrap">
        <span>Tobby — GPL-3.0 · Recipe spec &amp; SDK — Apache-2.0</span>
        <span><a href={org} rel="noopener">github.com/tobby-fetch</a></span>
      </div>
    </footer>
  </body>
</html>
